/ {
	aliases {
		i2c0 = &i2c_mgmt;
		i2c1 = &i2c_user;
	};
};

&gem3 {
	/delete-property/ local-mac-address;
	// mode=rgmii-id enables additional 2ns RX and TX clock delay
	phy-mode = "rgmii-id";
	phy-handle = <&phy0>;
	mdio {
		// KSZ9131
		phy0: phy@3 {
			reg = <3>;

			// 2 ns TX clock delay
			txc-skew-psec = <0>;
			txen-skew-psec = <0>;

			txd0-skew-psec = <0>;
			txd1-skew-psec = <0>;
			txd2-skew-psec = <0>;
			txd3-skew-psec = <0>;

			// 2 ns RX clock delay
			rxc-skew-psec = <0>;
			rxdv-skew-psec = <0>;

			rxd0-skew-psec = <0>;
			rxd1-skew-psec = <0>;
			rxd2-skew-psec = <0>;
			rxd3-skew-psec = <0>;
		};
	};
};

&gem1 {
	/delete-property/ local-mac-address;
	// mode=rgmii disables additional 2ns RX and TX clock delay
	phy-mode = "rgmii";
	phy-handle = <&phy1>;
	mdio {
		// KSZ9131
		phy1: phy@7 {
			reg = <7>;

			// 0 ns TX clock delay
			txc-skew-psec = <0>;
			txen-skew-psec = <0>;

			txd0-skew-psec = <0>;
			txd1-skew-psec = <0>;
			txd2-skew-psec = <0>;
			txd3-skew-psec = <0>;

			// -0.29 ns RX clock delay
			rxc-skew-psec = <(-700)>;
			rxdv-skew-psec = <0>;

			rxd0-skew-psec = <0>;
			rxd1-skew-psec = <0>;
			rxd2-skew-psec = <0>;
			rxd3-skew-psec = <0>;
		};
	};
};

&qspi {
	#address-cells = <1>;
	#size-cells = <0>;
	is-dual = <1>;
	num-cs = <2>;
	flash0: flash@0 {
		reg = <0x0>;
		compatible = "spansion,s25fl512s", "jedec,spi-nor";
		parallel-memories = /bits/ 64 <0x4000000 0x4000000>; /* 128MB */
		spi-rx-bus-width = <0x4>;
		spi-tx-bus-width = <0x4>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&psgtr {
	clocks = <&ref100>, <&ref135>;
	clock-names = "ref2", "ref3";
};

&amba {
	ref100: ref100M {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};
	ref135: ref135M {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <135000000>;
	};
	i2c_mgmt: i2c@ff020000 {
		clock-frequency = <100000>;
		atsha204a@64 {
			compatible = "atmel,atsha204a";
			reg = <0x64>;
		};
		irps5401@43 {
			compatible = "infineon,irps5401";
			reg = <0x43>;
		};
		irps5401@4d {
			compatible = "infineon,irps5401";
			reg = <0x4d>;
		};
		irps5401@4f {
			compatible = "infineon,irps5401";
			reg = <0x4f>;
		};
		tpm@2e {
			compatible = "tcg,tpm-tis-i2c";
			reg = <0x2e>;
		};
	};
	i2c_user: i2c@ff030000 {
		clock-frequency = <100000>;
	};
};
