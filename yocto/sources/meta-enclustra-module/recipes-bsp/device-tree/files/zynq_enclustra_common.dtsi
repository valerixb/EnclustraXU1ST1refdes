&i2c0 {
	clock-frequency = <100000>;

	atsha204a@64 {
		compatible = "atmel,atsha204a";
		reg = <0x64>;
	};
};

&qspi {
	#address-cells = <1>;
	#size-cells = <0>;
	is-dual = <0>;
	num-cs = <1>;
	flash0: flash@0 {
		reg = <0x0>;
		compatible = "spansion,s25fl512s", "jedec,spi-nor";
		spi-rx-bus-width = <0x4>;
		spi-tx-bus-width = <0x4>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&uart0 {
	cts-override ;
	device_type = "serial";
	port-number = <0>;
};

&clkc {
	fclk-enable = <0xF>;
	ps-clk-frequency = <33333333>;
};
