&i2c0 {
	// The isl12022 driver is used for the ISL12020M
	isl12022: isl12022@6f {
		compatible = "isil,isl12022";
		reg = <0x6f>;
	};
};

&gem0 {
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	/delete-property/ local-mac-address;

	mdio {
		phy0: ethernet-phy@3 {
			reg = <3>;

			txc-skew-ps = <1800>;
			txen-skew-ps = <420>;

			txd0-skew-ps = <420>;
			txd1-skew-ps = <420>;
			txd2-skew-ps = <420>;
			txd3-skew-ps = <420>;

			rxc-skew-ps = <900>;
			rxdv-skew-ps = <420>;

			rxd0-skew-ps = <420>;
			rxd1-skew-ps = <420>;
			rxd2-skew-ps = <420>;
			rxd3-skew-ps = <420>;
		};
	};
};
