/ {
	aliases {
		mmc0 = &sdhci0;
		mmc1 = &sdhci1;
	};
};

&dwc3_0 {
	dr_mode = "peripheral";
	snps,usb3_lpm_capable;
	maximum-speed = "high-speed";
};

&dwc3_1 {
	dr_mode = "host";
	snps,usb3_lpm_capable;
	maximum-speed = "high-speed";
};

/* SD1 with level shifter */
&sdhci1 {
	no-1-8-v;	/* for 1.0 silicon */
	wp-inverted;
	xlnx,mio_bank = <1>;
};

&amba {
	ref24: ref24M {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};
};

&i2c_mgmt {	
	lm96080@2f {
		compatible = "national,lm96080", "lm80";
		reg = <0x2f>;
	};
};
